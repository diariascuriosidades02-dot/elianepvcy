              <p>{pixCode}</p>
              <button onClick={copyPixCode}>{copied ? 'Código copiado' : 'Copiar código Pix'}</button>
            </div>
            <p className="payment-hint">Após o pagamento, envie o comprovante para confirmar sua assinatura.</p>
          </section>
        </div>
      )}
    </div>
  );
}

export default App;
