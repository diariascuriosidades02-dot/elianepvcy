        </article>

        <div className="bottom-note"><Camera size={15} /> Conteúdo protegido por Privacy</div>
      </main>

      {paymentOpen && (
        <div className="modal-backdrop" role="presentation" onClick={() => setPaymentOpen(false)}>
          <section className="payment-modal" role="dialog" aria-modal="true" aria-labelledby="payment-title" onClick={(event) => event.stopPropagation()}>
            <button className="modal-close" aria-label="Fechar pagamento" onClick={() => setPaymentOpen(false)}>×</button>
            <div className="payment-kicker">ASSINATURA VIP</div>
            <h2 id="payment-title">Pague via Pix</h2>
